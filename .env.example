# --- Acesso ao dashboard ---
# Password única de login
DASHBOARD_PASSWORD=
# Segredo para assinar o cookie de sessão (ex.: openssl rand -hex 32)
AUTH_SECRET=
# Token para o futuro dispositivo e-ink aceder a /eink?token=...
EINK_TOKEN=

# --- Notion ---
# Token da integração interna (https://www.notion.so/profile/integrations)
NOTION_TOKEN=
# Data source IDs (já verificados no workspace da Marta)
NOTION_ADHOC_DATA_SOURCE_ID=1ab7719e-3ca7-80c7-ba32-000b0dff28ec
NOTION_WORK_DATA_SOURCE_ID=2947719e-3ca7-80e2-b9ae-000b833f5e1e

# --- Apple Reminders (iCloud CalDAV) ---
ICLOUD_EMAIL=
# App-specific password criada em https://account.apple.com > Sign-In and Security
ICLOUD_APP_PASSWORD=
#
# Duas formas de escolher o que aparece em cada painel — usa UMA das duas por painel:
#
# (a) Por TAG — recomendado se usas Smart Lists no Reminders (filtros por tag,
# não listas reais). Preenche com o nome da tag, sem o "#":
REMINDERS_GROCERIES_TAG=
REMINDERS_DAILY_TAG=
#
# (b) Por LISTA — nome exato de uma lista real do iCloud. Só é usada se a
# variável de TAG correspondente acima estiver vazia.
REMINDERS_GROCERIES_LIST=Groceries
REMINDERS_DAILY_LIST=Daily

# --- Calendários (feeds ICS privados) ---
# Google Calendar > Definições do calendário > "Endereço secreto em formato iCal"
GOOGLE_ICS_URL=
# Outlook > Definições > Calendário > Calendários partilhados > Publicar > link ICS
OUTLOOK_ICS_URL=

# --- Meteorologia (Open-Meteo, sem chave) ---
WEATHER_LAT=38.7223
WEATHER_LON=-9.1393

# Fuso horário do dashboard
DASHBOARD_TZ=Europe/Lisbon
