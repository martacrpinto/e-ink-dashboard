# --- Acesso ao dashboard ---
# Password única de login
DASHBOARD_PASSWORD=
# Segredo para assinar o cookie de sessão (ex.: openssl rand -hex 32)
AUTH_SECRET=
# Token para o futuro dispositivo e-ink aceder a /eink?token=...
EINK_TOKEN=

# --- Notion ---
# Token da integração interna (https://www.notion.so/profile/integrations)
NOTION_TOKEN=
# Data source IDs (já verificados no workspace da Marta)
NOTION_ADHOC_DATA_SOURCE_ID=1ab7719e-3ca7-80c7-ba32-000b0dff28ec
NOTION_WORK_DATA_SOURCE_ID=2947719e-3ca7-80e2-b9ae-000b833f5e1e
# Nome (como aparece na propriedade "Assignee" do Notion) usado para filtrar as
# tarefas "Pessoal" atribuídas a mim. Default no código: Marta.
NOTION_ME_NAME=Marta

# --- Apple Reminders (via Atalho/Shortcut no iPhone, não CalDAV) ---
# O CalDAV do iCloud não expõe as listas/tags modernas dos Reminders (ver
# README). Um Atalho no iPhone envia os dados diretamente para cá.
# Token secreto que o Atalho usa para autenticar o POST (ex.: openssl rand -hex 16)
REMINDERS_INGEST_TOKEN=
# Necessário para guardar os dados recebidos: Vercel → Storage → Create
# Database → Blob. O Vercel define esta variável automaticamente ao ligar o
# projeto a um Blob Store — não precisas de a preencher à mão em produção.
# Para correr localmente, copia o token que o Vercel gerar.
BLOB_READ_WRITE_TOKEN=

# --- Calendários (feeds ICS privados) ---
# Google Calendar > Definições do calendário > "Endereço secreto em formato iCal"
GOOGLE_ICS_URL=
# Outlook > Definições > Calendário > Calendários partilhados > Publicar > link ICS
OUTLOOK_ICS_URL=

# --- Meteorologia (Open-Meteo, sem chave) ---
WEATHER_LAT=38.7223
WEATHER_LON=-9.1393

# Fuso horário do dashboard
DASHBOARD_TZ=Europe/Lisbon
